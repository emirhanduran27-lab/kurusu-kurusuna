{
  "name": "kurusu-kurusuna",
  "productName": "Kuruşu Kuruşuna",
  "version": "1.9.1",
  "description": "Gelir, gider, düzenli ödeme, bütçe ve birikim takibi",
  "main": "main.js",
  "author": "Emirhan Duran",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/emirhanduran27-lab/kurusu-kurusuna.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "dist:mac": "electron-builder --mac --publish never",
    "bridge": "esbuild mobile/bridge.js --bundle --format=iife --minify --target=es2020 --define:__KK_IOS__=false --outfile=renderer/vendor/mobile-bridge.js && esbuild mobile/cloud.js --bundle --format=iife --minify --target=es2020 --outfile=renderer/vendor/cloud.js && esbuild mobile/sheet.js --bundle --format=iife --minify --target=es2020 --outfile=renderer/vendor/sheet.js && esbuild mobile/pdf.js --bundle --format=iife --minify --target=es2020 --loader:.ttf=binary --outfile=renderer/vendor/pdf.js",
    "mobile:sync": "node scripts/mobile-sync.js",
    "android": "node scripts/mobile-sync.js android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@e965/xlsx": "^0.20.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "chart.js": "4.5.1",
    "electron": "38.8.6",
    "electron-builder": "26.0.20",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1"
  },
  "build": {
    "appId": "com.emirhan.gelirgider",
    "productName": "Kuruşu Kuruşuna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "KurusuKurusuna"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kuruşu Kuruşuna",
      "artifactName": "KurusuKurusuna-Kurulum-${version}.exe",
      "language": "1055"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emirhanduran27-lab",
        "repo": "kurusu-kurusuna",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "KurusuKurusuna-${version}-mac.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Kuruşu Kuruşuna ${version}",
      "artifactName": "KurusuKurusuna-${version}-mac.${ext}"
    },
    "protocols": [
      {
        "name": "Kuruşu Kuruşuna",
        "schemes": [
          "kurusukurusuna"
        ]
      }
    ]
  }
}
