{
  "name": "kurusu-kurusuna",
  "productName": "Kuruşu Kuruşuna",
  "version": "1.3.0",
  "description": "Gelir, gider, düzenli ödeme, bütçe ve birikim takibi",
  "main": "main.js",
  "author": "Emirhan Duran",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/emirhanduran27-lab/kurusu-kurusuna.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.20",
    "chart.js": "4.5.1"
  },
  "build": {
    "appId": "com.emirhan.gelirgider",
    "productName": "Kuruşu Kuruşuna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "KurusuKurusuna"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kuruşu Kuruşuna",
      "artifactName": "KurusuKurusuna-Kurulum-${version}.exe",
      "language": "1055"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emirhanduran27-lab",
        "repo": "kurusu-kurusuna",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "KurusuKurusuna-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Kuruşu Kuruşuna ${version}",
      "artifactName": "KurusuKurusuna-${version}-mac.${ext}"
    }
  }
}
